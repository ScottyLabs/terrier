{
  "openapi": "3.1.0",
  "info": {
    "title": "Terrier API",
    "description": "Hackathon management platform",
    "license": { "name": "AGPL-3.0-or-later" },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/callback": {
      "get": {
        "tags": ["auth"],
        "operationId": "callback",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "303": { "description": "Complete sign-in" },
          "400": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "tags": ["auth"],
        "operationId": "finish_login",
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "description": "Local application path after sign-in",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "303": { "description": "Redirect to Keycloak or the requested page" },
          "400": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["auth"],
        "operationId": "logout",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "Session-bound CSRF token",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Local session deleted" },
          "403": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/auth/status": {
      "get": {
        "tags": ["auth"],
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthStatus" } }
            }
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": { "200": { "content": { "text/plain": { "schema": { "type": "string" } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthStatus": {
        "type": "object",
        "properties": {
          "csrf_token": { "type": ["string", "null"] },
          "user": { "oneOf": [{ "$ref": "#/components/schemas/UserProfile" }, { "type": "null" }] }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Error response body. Omits empty field errors.",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "fields": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "propertyNames": { "type": "string" }
          },
          "message": { "type": "string" }
        }
      },
      "UserProfile": {
        "type": "object",
        "required": ["id", "email", "display_name", "email_verified"],
        "properties": {
          "display_name": { "type": "string" },
          "email": { "type": "string" },
          "email_verified": { "type": "boolean" },
          "id": { "type": "string" }
        }
      }
    }
  }
}
